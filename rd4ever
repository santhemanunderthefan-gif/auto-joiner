-- Get the Accept button using the exact path
local function getAcceptButton()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return nil end
    
    local create = crew:FindFirstChild("Create")
    if not create then return nil end
    
    local invite = create:FindFirstChild("Invite")
    if not invite then return nil end
    
    return invite:FindFirstChild("Accept")
end

-- Check if player actually joined the crew
local function checkIfJoinedCrew()
    -- Check crew UI to see if we're in a crew now
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return false end
    
    -- If we're in a crew, the Create frame might be gone or different
    local create = crew:FindFirstChild("Create")
    if not create then 
        -- Create frame missing means we might be in a crew already
        return true
    end
    
    -- Check if invite frame is gone (means we accepted)
    local invite = create:FindFirstChild("Invite")
    if invite and invite.Visible == false then
        return true
    end
    
    return false
end

-- Check for invite button
local function checkForInvite()
    local acceptBtn = getAcceptButton()
    
    local hasRealInvite = false
    if acceptBtn then
        local invite = acceptBtn.Parent
        if invite and invite.Visible == true then
            hasRealInvite = acceptBtn.Visible == true and acceptBtn.Active == true
        end
    end
    
    if hasRealInvite then
        if not hasInvite then
            hasInvite = true
            updateInviteStatus(true)
            print("🔔 READY - Invite received!")
        end
        return true
    else
        if hasInvite then
            hasInvite = false
            updateInviteStatus(false)
            print("⏳ Waiting for invite...")
        end
        return false
    end
end

-- Execute click using MULTIPLE METHODS to ensure it works
local function executeClick()
    if crewJoined then 
        print("✅ Already joined crew")
        return true
    end
    
    local acceptBtn = getAcceptButton()
    
    if not acceptBtn then
        print("❌ Accept button not found!")
        return false
    end
    
    if not acceptBtn.Visible then
        print("❌ Accept button is not visible!")
        return false
    end
    
    -- Method 1: Fire the button directly (if possible)
    local success, err = pcall(function()
        acceptBtn:Activate()
    end)
    
    if success then
        print("✅ Method 1: Button activated directly")
        task.wait(0.5)
    else
        print("⚠️ Method 1 failed, trying hardware click...")
        
        -- Method 2: Hardware mouse click
        local x = acceptBtn.AbsolutePosition.X + (acceptBtn.AbsoluteSize.X / 2)
        local y = acceptBtn.AbsolutePosition.Y + (acceptBtn.AbsoluteSize.Y / 2) + 58
        
        print("🎯 Clicking at position: " .. x .. ", " .. y)
        
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end
    
    -- Wait a moment for the join to process
    print("⏳ Waiting for crew join to process...")
    task.wait(2)
    
    -- Verify we actually joined the crew
    for i = 1, 5 do
        task.wait(1)
        if checkIfJoinedCrew() then
            crewJoined = true
            acceptedInvite = true
            updateAcceptedStatus()
            print("✅ Successfully joined the crew!")
            return true
        end
        print("⏳ Verifying crew join... (" .. i .. "/5)")
    end
    
    if crewJoined then
        return true
    else
        print("⚠️ Click executed but crew join not verified yet")
        -- Don't mark as accepted until verified
        return false
    end
end

-- Poll for sync commands
local function pollSync()
    task.spawn(function()
        while isRunning do
            if hasInvite and not crewJoined and requestFunc then
                local success, response = pcall(function()
                    return requestFunc({
                        Url = SERVER_URL .. "/api/sync-command/" .. username,
                        Method = "GET"
                    })
                end)
                
                if success and response and response.StatusCode == 200 then
                    local data = httpService:JSONDecode(response.Body)
                    if data.sync then
                        print("========================================")
                        print("🎬 GLOBAL SYNC TRIGGERED!")
                        print("⏰ Countdown: " .. data.delay .. " seconds")
                        print("========================================")
                        
                        -- Countdown
                        for i = data.delay, 1, -1 do
                            print("⏰ " .. i .. "...")
                            task.wait(1)
                        end
                        
                        print("🎯 EXECUTING CLICK NOW!")
                        local clicked = executeClick()
                        
                        if clicked then
                            print("✅ Sync complete! Joined crew!")
                        else
                            print("⚠️ Sync executed but waiting for crew verification")
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- Keep username alive with heartbeat
local function keepAlive()
    task.spawn(function()
        while isRunning do
            sendHeartbeat()
            task.wait(5)
        end
    end)
    
    task.spawn(function()
        while isRunning do
            sendUsername()
            task.wait(15)
        end
    end)
end

-- Monitor for invite button
local function monitorInvite()
    task.spawn(function()
        while isRunning do
            checkForInvite()
            task.wait(0.5)
        end
    end)
end

-- Monitor if crew was joined (for manual accepts)
local function monitorCrewJoin()
    task.spawn(function()
        while isRunning do
            if not crewJoined and checkIfJoinedCrew() then
                crewJoined = true
                acceptedInvite = true
                updateAcceptedStatus()
                print("✅ Detected crew join!")
            end
            task.wait(1)
        end
    end)
end

-- Leave detection
local function setupLeaveDetection()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        playerGui.AncestryChanged:Connect(function()
            if not playerGui.Parent then
                sendLeave()
                isRunning = false
            end
        end)
    end
    
    localPlayer.AncestryChanged:Connect(function()
        if not localPlayer.Parent then
            sendLeave()
            isRunning = false
        end
    end)
end

