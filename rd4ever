-- ============ FPS LOCK AT 15 ============

local function lockFPS()
    print("🔒 Locking FPS to 15...")
    
    -- Method 1: Set FrameRateLimit (if available)
    pcall(function()
        userSettings:GetService("UserGameSettings").FrameRateLimit = 15
    end)
    
    -- Method 2: Set FPS Cap via settings
    pcall(function()
        local settings = userSettings:GetService("UserGameSettings")
        settings.FrameRateLimit = 15
    end)
    
    -- Method 3: Actively throttle render events
    local lastFrame = os.clock()
    local frameTime = 1 / 15 -- 0.0666 seconds per frame
    
    local connection
    connection = runService.RenderStepped:Connect(function()
        local now = os.clock()
        local elapsed = now - lastFrame
        
        if elapsed < frameTime then
            task.wait(frameTime - elapsed)
        end
        lastFrame = os.clock()
    end)
    
    -- Method 4: Lower priority of game
    pcall(function()
        runService:SetWindowingSmooth(false)
    end)
    
    -- Method 5: Disable certain visual effects to save performance
    pcall(function()
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = false
        lighting.FogStart = 0
        lighting.FogEnd = 100
        lighting.FogColor = Color3.new(1, 1, 1)
    end)
    
    print("✅ FPS locked at 15")
    return connection
end

-- ============ SCREEN WHITENING EFFECT ============

-- Create a white overlay GUI
local function createWhiteOverlay()
    if game.CoreGui:FindFirstChild("WhiteOverlay") then
        return game.CoreGui:FindFirstChild("WhiteOverlay")
    end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "WhiteOverlay"
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.Position = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3 = Color3.new(1, 1, 1)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.ZIndex = 999
    
    frame.Parent = screenGui
    screenGui.Parent = game.CoreGui
    
    return screenGui
end

local function fadeToWhite(duration)
    local overlay = createWhiteOverlay()
    local frame = overlay:FindFirstChild("Frame")
    
    if frame then
        local tweenInfo = TweenInfo.new(duration or 1, Enum.EasingStyle.Linear)
        local tween = tweenService:Create(frame, tweenInfo, {BackgroundTransparency = 0})
        tween:Play()
        tween.Completed:Wait()
    end
end

local function setScreenWhite(transparency)
    local overlay = createWhiteOverlay()
    local frame = overlay:FindFirstChild("Frame")
    
    if frame then
        frame.BackgroundTransparency = transparency or 0
    end
end

local function hideGameWorld()
    -- Hide terrain
    local workspace = game:GetService("Workspace")
    local terrain = workspace:FindFirstChild("Terrain")
    if terrain then
        pcall(function()
            terrain.WaterReflectance = 1
            terrain.WaterTransparency = 1
        end)
    end
    
    -- Hide all parts
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("BasePart") and child ~= workspace.CurrentCamera then
            pcall(function()
                child.LocalTransparencyModifier = 1
                child.CastShadow = false
            end)
        elseif child:IsA("Model") and child ~= localPlayer.Character then
            pcall(function()
                for _, part in ipairs(child:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.LocalTransparencyModifier = 1
                    end
                end
            end)
        end
    end
    
    -- Set fog to white
    local lighting = game:GetService("Lighting")
    lighting.FogColor = Color3.new(1, 1, 1)
    lighting.FogEnd = 1
    lighting.FogStart = 0
    lighting.Ambient = Color3.new(1, 1, 1)
    lighting.Brightness = 2
    lighting.ColorShift_Top = Color3.new(1, 1, 1)
    lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
    lighting.GlobalShadows = false
    
    -- Create white bloom effect
    local bloom = Instance.new("BloomEffect")
    bloom.Intensity = 0.5
    bloom.Size = 30
    bloom.Parent = lighting
end

