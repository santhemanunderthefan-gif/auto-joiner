-- Check for REAL invite (invite frame visible)
local function checkForInvite()
    if hasAccepted then return false end
    
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return false end
    
    local create = crew:FindFirstChild("Create")
    if not create then return false end
    
    local invite = create:FindFirstChild("Invite")
    
    if invite and invite.Visible == true then
        if not hasInvite then
            hasInvite = true
            updateInviteStatus(true)
            print("🔔 INVITE DETECTED!")
        end
        return true
    else
        if hasInvite then
            hasInvite = false
            updateInviteStatus(false)
        end
        return false
    end
end

-- Accept invite (NO CLICKS - Direct remote)
local function acceptInvite()
    if hasAccepted then return true end
    
    print("🎬 Accepting invite remotely...")
    
    -- Try method 1: Direct remote
    if acceptInviteDirectly() then
        hasAccepted = true
        hasInvite = false
        updateAcceptedStatus()
        print("✅ ACCEPTED via remote!")
        return true
    end
    
    -- Try method 2: With invite data
    if acceptWithInviteData() then
        hasAccepted = true
        hasInvite = false
        updateAcceptedStatus()
        print("✅ ACCEPTED via invite data!")
        return true
    end
    
    print("❌ Could not accept invite remotely")
    return false
end

-- Poll for sync commands
local function pollSync()
    task.spawn(function()
        while isRunning do
            if hasInvite and not hasAccepted and requestFunc then
                local success, response = pcall(function()
                    return requestFunc({
                        Url = SERVER_URL .. "/api/sync-command/" .. username,
                        Method = "GET"
                    })
                end)
                
                if success and response and response.StatusCode == 200 then
                    local data = httpService:JSONDecode(response.Body)
                    if data.sync then
                        print("========================================")
                        print("🎬 GLOBAL SYNC TRIGGERED!")
                        print("⏰ Countdown: " .. data.delay .. " seconds")
                        print("========================================")
                        
                        for i = data.delay, 1, -1 do
                            print("⏰ " .. i)
                            task.wait(1)
                        end
                        
                        acceptInvite()
                    end
                end
            end
            task.wait(1)
        end
    end)
end

