-- Get Accept button
local function getAcceptButton()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return nil end
    
    local create = crew:FindFirstChild("Create")
    if not create then return nil end
    
    local invite = create:FindFirstChild("Invite")
    if not invite then return nil end
    
    return invite:FindFirstChild("Accept")
end

-- Check for REAL invite
local function checkForInvite()
    if hasAccepted then return false end
    
    local realInvite = hasRealInvite()
    
    if realInvite then
        if not hasInvite then
            hasInvite = true
            updateInviteStatus(true)
            print("🔔 REAL INVITE DETECTED! Ready for sync")
        end
        return true
    else
        if hasInvite then
            hasInvite = false
            updateInviteStatus(false)
            print("⏳ No invite - Waiting...")
        end
        return false
    end
end

-- Click accept button (2 pixels to the LEFT, no Y change)
local function clickAcceptButton()
    if hasAccepted then return true end
    
    local acceptBtn = getAcceptButton()
    
    if not acceptBtn or not acceptBtn.Visible then
        print("❌ Accept button not visible")
        return false
    end
    
    print("🎯 Clicking Accept button...")
    
    -- Try direct activation first
    local success = pcall(function()
        acceptBtn:Activate()
    end)
    
    if success then
        print("✅ Direct activation worked!")
        hasAccepted = true
        hasInvite = false
        updateAcceptedStatus()
        return true
    end
    
    -- Calculate click position - 2 pixels to the LEFT (X - 2, Y unchanged)
    local x = acceptBtn.AbsolutePosition.X + (acceptBtn.AbsoluteSize.X / 2) - 2  -- 2 pixels LEFT
    local y = acceptBtn.AbsolutePosition.Y + (acceptBtn.AbsoluteSize.Y / 2)      -- NO Y change
    
    -- Only add offset for the top bar on PC/mobile (this is necessary for the button to be clickable)
    if isMobile() then
        y = y + 30  -- Mobile top bar offset
    else
        y = y + 58  -- PC top bar offset
    end
    
    print("📍 Clicking at: X=" .. x .. ", Y=" .. y .. " (2px LEFT from center)")
    
    -- Send hardware click
    vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.1)
    vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    
    task.wait(0.5)
    
    hasAccepted = true
    hasInvite = false
    updateAcceptedStatus()
    print("✅ ACCEPTED! Joined crew!")
    return true
end

-- Poll for sync commands
local function pollSync()
    task.spawn(function()
        while isRunning do
            if hasInvite and not hasAccepted and requestFunc then
                local success, response = pcall(function()
                    return requestFunc({
                        Url = SERVER_URL .. "/api/sync-command/" .. username,
                        Method = "GET"
                    })
                end)
                
                if success and response and response.StatusCode == 200 then
                    local data = httpService:JSONDecode(response.Body)
                    if data.sync then
                        print("========================================")
                        print("🎬 GLOBAL SYNC TRIGGERED!")
                        print("⏰ Countdown: " .. data.delay .. " seconds")
                        print("========================================")
                        
                        for i = data.delay, 1, -1 do
                            print("⏰ " .. i)
                            task.wait(1)
                        end
                        
                        clickAcceptButton()
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- Keep alive
local function keepAlive()
    task.spawn(function()
        while isRunning do
            sendHeartbeat()
            task.wait(5)
        end
    end)
    
    task.spawn(function()
        while isRunning do
