        playerGui.AncestryChanged:Connect(function()
            if not playerGui.Parent then
                sendLeave()
                isRunning = false
            end
        end)
    end
    
    localPlayer.AncestryChanged:Connect(function()
        if not localPlayer.Parent then
            sendLeave()
            isRunning = false
        end
    end)
end

