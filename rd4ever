-- Send username to server
local function sendUsername()
    if not requestFunc then return end
    
    local data = {
        username = username,
        userId = userId,
        timestamp = os.time(),
        executor = "Xeno"
    }
    
    pcall(function()
        requestFunc({
            Url = SERVER_URL .. "/api/username",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)
end

