print("========================================")
print("🚀 CREW SYNC FOR XENO")
print("========================================")
print("👤 Account: " .. username)
print("🌐 Web Panel: " .. SERVER_URL)
print("========================================")

sendUsername()
keepAlive()
monitorInvite()
pollSync()
setupLeaveDetection()

