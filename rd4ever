repeat task.wait() until game:IsLoaded()

-- Detect executor request function
local requestFunc = nil
if Xeno and Xeno.HttpRequest then
    requestFunc = Xeno.HttpRequest
elseif Xeno and Xeno.request then
    requestFunc = Xeno.request
elseif syn and syn.request then
    requestFunc = syn.request
elseif request then
    requestFunc = request
end

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local username = localPlayer.Name
local userId = localPlayer.UserId
local httpService = game:GetService("HttpService")
local vim = game:GetService("VirtualInputManager")

local SERVER_URL = "https://pk-glitch.onrender.com"
local hasInvite = false
local hasAccepted = false  -- Only becomes true AFTER sync click
local isRunning = true

-- Join Pirates
local replicatedStorage = game:GetService("ReplicatedStorage")
local commF = replicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
pcall(function()
    commF:InvokeServer("SetTeam", "Pirates")
end)

-- Send username to server
local function sendUsername()
    if not requestFunc then return end
    
    local data = {
        username = username,
        userId = userId,
        timestamp = os.time(),
        executor = "Xeno"
    }
    
    pcall(function()
        requestFunc({
            Url = SERVER_URL .. "/api/username",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)
end

