            task.wait(30)
        end
    end)
end

-- Monitor invites
local function monitorInvite()
    task.spawn(function()
        while isRunning do
            checkForInvite()
            task.wait(1)
        end
    end)
end

-- Leave detection
local function setupLeaveDetection()
    localPlayer.AncestryChanged:Connect(function()
        if not localPlayer.Parent then
            sendLeave()
            isRunning = false
        end
    end)
end

