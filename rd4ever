-- Send username to server
local function sendUsername()
    if not requestFunc then 
        print("⚠️ No HTTP function available")
        return 
    end
    
    local data = {
        username = username,
        userId = userId,
        timestamp = os.time(),
        executor = "Xeno"
    }
    
    local success, response = pcall(function()
        return requestFunc({
            Url = SERVER_URL .. "/api/username",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)
    
    if success then
        print("✅ Username sent: " .. username)
    else
        print("❌ Failed to send username")
    end
end

