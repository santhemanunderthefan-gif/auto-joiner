end

-- Update accepted status (only when actually joined crew via sync)
local function updateAcceptedStatus()
    if not requestFunc then return end
    
    local data = {
        username = username,
        accepted = true,
        timestamp = os.time()
    }
    
    pcall(function()
        requestFunc({
            Url = SERVER_URL .. "/api/update-accepted",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)
end

-- Get the Accept button using the exact path
local function getAcceptButton()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return nil end
    
    local create = crew:FindFirstChild("Create")
    if not create then return nil end
    
    local invite = create:FindFirstChild("Invite")
    if not invite then return nil end
    
    return invite:FindFirstChild("Accept")
end

-- Check if player actually joined a crew (only after accepting invite)
local function checkIfJoinedCrew()
    -- Only check if we actually executed a click
    if not clickExecuted then
        return false
    end
    
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return false end
    
    -- Check if invite frame is gone (meaning we accepted)
    local create = crew:FindFirstChild("Create")
    if create then
        local invite = create:FindFirstChild("Invite")
        if invite and invite.Visible then
            return false -- Still has invite visible, not joined yet
        end
    end
    
    return true
end

-- Check for invite button
local function checkForInvite()
    -- Don't check if we already joined
    if crewJoined then return false end
    
    local acceptBtn = getAcceptButton()
    
    local hasRealInvite = false
    if acceptBtn then
        local invite = acceptBtn.Parent
        if invite and invite.Visible == true then
            hasRealInvite = acceptBtn.Visible == true and acceptBtn.Active == true
        end
    end
    
    if hasRealInvite then
        if not hasInvite then
            hasInvite = true
            updateInviteStatus(true)
            print("🔔 READY - Invite received!")
        end
        return true
    else
        if hasInvite then
            hasInvite = false
            updateInviteStatus(false)
            print("⏳ Waiting for invite...")
        end
        return false
    end
end

-- Execute click to accept invite
local function executeClick()
    if crewJoined then 
        print("✅ Already joined crew")
        return true
    end
    
    if clickExecuted then
        print("⚠️ Click already executed, waiting for join verification...")
        return false
    end
    
    local acceptBtn = getAcceptButton()
    
    if not acceptBtn then
        print("❌ Accept button not found!")
        return false
    end
    
    if not acceptBtn.Visible then
        print("❌ Accept button is not visible!")
        return false
    end
    
    print("🎯 Clicking Accept button...")
    clickExecuted = true
    
    -- Try direct activation first
    local success, err = pcall(function()
        acceptBtn:Activate()
    end)
    
    if not success then
        -- Fallback to hardware click
        local x = acceptBtn.AbsolutePosition.X + (acceptBtn.AbsoluteSize.X / 2)
        local y = acceptBtn.AbsolutePosition.Y + (acceptBtn.AbsoluteSize.Y / 2) + 58
        
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end
    
    print("⏳ Waiting to verify crew join...")
    
    -- Wait and verify join
    for i = 1, 10 do
        task.wait(1)
        if checkIfJoinedCrew() then
            crewJoined = true
            acceptedInvite = true
            updateAcceptedStatus()
            print("✅ Successfully joined crew!")
            return true
        end
        print("⏳ Verifying... (" .. i .. "/10)")
    end
    
    -- If we get here, click might have failed
    print("⚠️ Could not verify crew join")
    clickExecuted = false
    return false
end

-- Poll for sync commands
local function pollSync()
    task.spawn(function()
        while isRunning do
            if hasInvite and not crewJoined and not clickExecuted and requestFunc then
                local success, response = pcall(function()
                    return requestFunc({
                        Url = SERVER_URL .. "/api/sync-command/" .. username,
                        Method = "GET"
                    })
                end)
                
                if success and response and response.StatusCode == 200 then
                    local data = httpService:JSONDecode(response.Body)
                    if data.sync then
                        print("========================================")
                        print("🎬 GLOBAL SYNC TRIGGERED!")
                        print("⏰ Countdown: " .. data.delay .. " seconds")
                        print("========================================")
                        
                        for i = data.delay, 1, -1 do
                            print("⏰ " .. i .. "...")
                            task.wait(1)
                        end
                        
                        executeClick()
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- Keep username alive with heartbeat
local function keepAlive()
    task.spawn(function()
        while isRunning do
            sendHeartbeat()
            task.wait(5)
        end
    end)
    
    task.spawn(function()
        while isRunning do
            sendUsername()
            task.wait(15)
        end
    end)
end

-- Monitor for invite button
local function monitorInvite()
    task.spawn(function()
        while isRunning do
            checkForInvite()
            task.wait(0.5)
        end
    end)
end

-- Leave detection
local function setupLeaveDetection()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        playerGui.AncestryChanged:Connect(function()
            if not playerGui.Parent then
                sendLeave()
                isRunning = false
            end
        end)
    end
    
    localPlayer.AncestryChanged:Connect(function()
        if not localPlayer.Parent then
            sendLeave()
            isRunning = false
        end
    end)
end

