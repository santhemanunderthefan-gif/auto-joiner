local function xor_crypt(data, key)
    local result = {}
    for i = 1, #data do
        local char = string.byte(data, i)
        local key_char = string.byte(key, ((i-1) % #key) + 1)
        result[i] = string.char(bit32.bxor(char, key_char))
    end
    return table.concat(result)
end

