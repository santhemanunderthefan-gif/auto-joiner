--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🏴‍☠️ CREW SYNC - WebSocket Only Version
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInput = game:GetService("VirtualInputManager")
local WebSocket = game:GetService("WebSocket")

local player = Players.LocalPlayer
local WS_URL = "wss://rd4ever.onrender.com/socket.io/?EIO=4&transport=websocket"

print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("🏴‍☠️ CREW SYNC - WebSocket Only")
print("👤 Account:", player.Name)
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

local socket = nil
local syncReceived = false
local syncDelay = 5

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🔌 CONNECT WEBSOCKET
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function connectWebSocket()
    local success, ws = pcall(function()
        return WebSocket.connect(WS_URL)
    end)
    
    if success and ws then
        socket = ws
        print("✅ WebSocket connected!")
        
        -- Send registration to server
        task.wait(1)
        local registerMsg = '42["register_client",{"username":"' .. player.Name .. '"}]'
        pcall(function() socket:Send(registerMsg) end)
        print("📡 Registered:", player.Name)
        
        -- Listen for sync command
        socket.OnMessage:Connect(function(message)
            print("📩 Received:", message)
            
            if message and message:find('"execute_sync"') then
                local delayMatch = message:match('"delay":(%d+)')
                if delayMatch then
                    syncDelay = tonumber(delayMatch)
                end
                syncReceived = true
                print("🔥 SYNC COMMAND! Delay:", syncDelay)
            end
        end)
        
        return true
    end
    
    print("❌ WebSocket failed:", ws)
    return false
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🏴‍☠️ JOIN PIRATES
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function joinPirates()
    print("🏴‍☠️ Joining Pirates...")
    
    repeat task.wait() until game:IsLoaded()
    task.wait(2)
    
    pcall(function()
        local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if Remotes then
            local CommF = Remotes:FindFirstChild("CommF_")
            if CommF then
                CommF:InvokeServer("SetTeam", "Pirates")
                print("✅ Joined Pirates!")
            end
        end
    end)
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🔍 FIND INVITE BUTTON
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function findInviteButton()
    if not player or not player.PlayerGui then return nil end
    
    local paths = {
        "Main.Crew.Create.Invite.Accept",
        "Main.Crew.Invite.Accept",
        "Crew.Invite.Accept",
        "Main.Dialog.Confirm"
    }
    
    for _, path in ipairs(paths) do
        local success, btn = pcall(function()
            local current = player.PlayerGui
            for part in string.gmatch(path, "[^%.]+") do
                current = current:FindFirstChild(part)
                if not current then break end
            end
            return current
        end)
        
        if success and btn and btn:IsA("TextButton") and btn.Visible then
            return btn
        end
    end
    
    return nil
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🖱️ CLICK BUTTON
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function clickButton(btn)
    if not btn then return false end
    
    return pcall(function()
        local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
        local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2 + 58
        
        VirtualInput:SendMouseMoveEvent(x, y, 0, game)
        task.wait(0.05)
        VirtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.1)
        VirtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
        
        print("✅ Clicked invite!")
    end)
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- ⏳ WAIT FOR SYNC
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function waitForSync()
    print("⏳ Waiting for sync command...")
    
    while not syncReceived do
        task.wait(0.1)
    end
    
    print("🔥 SYNC STARTING in", syncDelay, "seconds!")
    
    for i = syncDelay, 1, -1 do
        print("⏱️ Joining in", i, "...")
        task.wait(1)
    end
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🔍 MONITOR FOR INVITES
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function monitorInvites()
    while true do
        local btn = findInviteButton()
        
        if btn then
            print("📩 INVITE DETECTED!")
            
            -- Wait for sync command
            waitForSync()
            
            -- Click the button
            if clickButton(btn) then
                print("✅ Successfully joined crew!")
            else
                print("❌ Failed to click invite")
            end
            
            break
        end
        
        task.wait(2)
    end
end

--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
-- 🚀 MAIN
--━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
local function main()
    repeat task.wait()
        player = Players.LocalPlayer
    until player and player.Name ~= ""
    
    print("🚀 Starting Crew Sync for", player.Name)
    
    -- Connect WebSocket
    if not connectWebSocket() then
        print("❌ Cannot connect to server. Check if Render is running.")
        return
    end
    
    -- Join Pirates
    joinPirates()
    
    -- Monitor for invites
    monitorInvites()
end

-- Start
local success, err = pcall(main)
if not success then
    print("❌ Error:", err)
end

-- Keep alive
while true do
    task.wait(60)
end
