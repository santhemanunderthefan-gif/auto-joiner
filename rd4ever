-- ============ WORKING FPS CAP AT 15 ============
local function lockFPS()
    print("🔒 Setting FPS cap to 15...")
    
    pcall(function()
        local UserSettings = game:GetService("UserSettings")
        local GameSettings = UserSettings:GetService("UserGameSettings")
        GameSettings.FrameRateLimit = 15
    end)
    
    pcall(function()
        settings().Rendering.QualityLevel = 1
    end)
    
    local frameTime = 1 / 15
    local lastTime = tick()
    
    runService.RenderStepped:Connect(function()
        local currentTime = tick()
        local delta = currentTime - lastTime
        if delta < frameTime then
            task.wait(frameTime - delta)
        end
        lastTime = tick()
    end)
    
    print("✅ FPS cap set to 15")
end

-- ============ WHITE SCREEN (Full White) ============
local function enableWhiteScreen()
    print("🌕 Enabling white screen mode...")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "WhiteScreenOverlay"
    screenGui.IgnoreGuiInset = true
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local whiteFrame = Instance.new("Frame")
    whiteFrame.Size = UDim2.new(1, 0, 1, 0)
    whiteFrame.Position = UDim2.new(0, 0, 0, 0)
    whiteFrame.BackgroundColor3 = Color3.new(1, 1, 1)
    whiteFrame.BackgroundTransparency = 0
    whiteFrame.BorderSizePixel = 0
    whiteFrame.ZIndex = 999
    whiteFrame.Parent = screenGui
    
    pcall(function()
        screenGui.Parent = game:GetService("CoreGui")
    end)
    
    pcall(function()
        lighting.Ambient = Color3.new(1, 1, 1)
        lighting.Brightness = 2
        lighting.ClockTime = 12
        lighting.FogColor = Color3.new(1, 1, 1)
        lighting.FogEnd = 0.1
        lighting.FogStart = 0
        lighting.GlobalShadows = false
        lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    end)
    
    pcall(function()
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("BasePart") and child ~= workspace.CurrentCamera then
                child.Transparency = 1
            elseif child:IsA("Model") and child ~= localPlayer.Character then
                for _, part in ipairs(child:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 1
                    end
                end
            end
        end
    end)
    
    print("✅ White screen mode enabled")
end

-- ============ CLICK CREW BUTTON ONCE ============
local function clickCrewButton()
    if crewButtonClicked then return end
    
    print("🎯 Looking for CrewButton...")
    
    repeat task.wait(0.5) until localPlayer.PlayerGui
    
    local crewButton = nil
    
    pcall(function()
        if starterGui and starterGui.Main and starterGui.Main.HUDButtonBar and starterGui.Main.HUDButtonBar.CrewButton then
            crewButton = starterGui.Main.HUDButtonBar.CrewButton
        end
    end)
    
    if not crewButton then
        pcall(function()
            if localPlayer.PlayerGui.Main and localPlayer.PlayerGui.Main.HUDButtonBar and localPlayer.PlayerGui.Main.HUDButtonBar.CrewButton then
                crewButton = localPlayer.PlayerGui.Main.HUDButtonBar.CrewButton
            end
        end)
    end
    
    if not crewButton then
        pcall(function()
            crewButton = localPlayer.PlayerGui:FindFirstChild("Main", true):FindFirstChild("CrewButton", true)
        end)
    end
    
    if crewButton and crewButton.Visible then
        print("✅ Found CrewButton! Clicking...")
        
        local success = pcall(function()
            crewButton:Activate()
        end)
        
        if not success then
            local x = crewButton.AbsolutePosition.X + (crewButton.AbsoluteSize.X / 2)
            local y = crewButton.AbsolutePosition.Y + (crewButton.AbsoluteSize.Y / 2)
            
            -- Different offset for mobile vs PC
            if isMobile() then
                y = y + 30 -- Mobile offset (smaller top bar)
            else
                y = y + 58 -- PC offset
            end
            
            vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.1)
            vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
        
        crewButtonClicked = true
        print("✅ Crew button clicked!")
    else
        print("⚠️ CrewButton not found - retrying")
        task.wait(3)
        if not crewButtonClicked then
            clickCrewButton()
        end
    end
end

-- ============ FIXED CLICK FOR MOBILE ============
local function clickAcceptButton()
    if hasAccepted then return true end
    
    local acceptBtn = getAcceptButton()
    
    if not acceptBtn or not acceptBtn.Visible then
        print("❌ Accept button not visible")
        return false
    end
    
    print("🎯 Clicking Accept button...")
    
    -- Try direct activation first
    local success = pcall(function()
        acceptBtn:Activate()
    end)
    
    if success then
        print("✅ Direct activation worked!")
        hasAccepted = true
        hasInvite = false
        updateAcceptedStatus()
        return true
    end
    
    -- Calculate click position
    local x = acceptBtn.AbsolutePosition.X + (acceptBtn.AbsoluteSize.X / 2)
    local y = acceptBtn.AbsolutePosition.Y + (acceptBtn.AbsoluteSize.Y / 2)
    
    -- Adjust offset based on device
    if isMobile() then
        -- On mobile, the top bar is smaller or non-existent
        -- Try clicking at exact center first
        print("📱 Mobile mode - clicking at center")
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
        task.wait(0.5)
        
        -- Check if accepted, if not try with offset
        if not hasAccepted then
            print("📱 Trying with mobile offset...")
            local y2 = y + 40
            vim:SendMouseButtonEvent(x, y2, 0, true, game, 0)
            task.wait(0.1)
            vim:SendMouseButtonEvent(x, y2, 0, false, game, 0)
        end
    else
        -- PC mode
        local yOffset = y + 58
        print("💻 PC mode - clicking at: " .. x .. ", " .. yOffset)
        vim:SendMouseButtonEvent(x, yOffset, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(x, yOffset, 0, false, game, 0)
    end
    
    task.wait(1)
    
    -- Double check if we need to try again
    local checkAgain = getAcceptButton()
    if checkAgain and checkAgain.Visible then
        print("🔄 Click didn't register, trying again...")
        local x2 = acceptBtn.AbsolutePosition.X + (acceptBtn.AbsoluteSize.X / 2)
        local y2 = acceptBtn.AbsolutePosition.Y + (acceptBtn.AbsoluteSize.Y / 2)
        
        if isMobile() then
            vim:SendMouseButtonEvent(x2, y2 + 35, 0, true, game, 0)
            task.wait(0.1)
            vim:SendMouseButtonEvent(x2, y2 + 35, 0, false, game, 0)
        else
            vim:SendMouseButtonEvent(x2, y2 + 55, 0, true, game, 0)
            task.wait(0.1)
            vim:SendMouseButtonEvent(x2, y2 + 55, 0, false, game, 0)
        end
    end
    
    hasAccepted = true
    hasInvite = false
    updateAcceptedStatus()
    print("✅ ACCEPTED! Joined crew!")
    return true
end

-- ============ INVITE DETECTION ============
local function hasRealInvite()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return false end
    
    local create = crew:FindFirstChild("Create")
    if not create then return false end
    
    local invite = create:FindFirstChild("Invite")
    if not invite then return false end
    
    if invite.Visible == true then
        local acceptBtn = invite:FindFirstChild("Accept")
        if acceptBtn and acceptBtn.Visible == true then
            return true
        end
    end
    
    return false
end

-- ============ HTTP FUNCTIONS ============

local function sendUsername()
    if not requestFunc then return end
    
    local data = {
        username = username,
        userId = userId,
        timestamp = os.time(),
        executor = isMobile() and "Mobile" or "PC"
    }
    
    pcall(function()
        requestFunc({
            Url = SERVER_URL .. "/api/username",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)
    print("📡 Username sent: " .. username .. " (" .. (isMobile() and "Mobile" or "PC") .. ")")
end

