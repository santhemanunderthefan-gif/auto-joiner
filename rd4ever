-- ============ DIRECT REMOTE TO ACCEPT INVITE (NO CLICK) ============
local function acceptInviteDirectly()
    print("🎯 Accepting invite directly via remote...")
    
    -- Find the remote for accepting invites
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local remotes = replicatedStorage:FindFirstChild("Remotes")
    
    if not remotes then
        print("❌ Remotes folder not found!")
        return false
    end
    
    -- Look for the accept invite remote
    local acceptRemote = remotes:FindFirstChild("AcceptInvite")
    if not acceptRemote then
        acceptRemote = remotes:FindFirstChild("JoinCrew")
    end
    if not acceptRemote then
        acceptRemote = remotes:FindFirstChild("AcceptCrewInvite")
    end
    if not acceptRemote then
        acceptRemote = remotes:FindFirstChild("RespondToInvite")
    end
    
    if acceptRemote then
        print("✅ Found remote: " .. acceptRemote.Name)
        
        -- Try to fire/invoke it
        local success = pcall(function()
            if acceptRemote:IsA("RemoteEvent") then
                acceptRemote:FireServer(true) -- true = accept
                print("✅ Fired RemoteEvent to accept invite")
            elseif acceptRemote:IsA("RemoteFunction") then
                acceptRemote:InvokeServer(true)
                print("✅ Invoked RemoteFunction to accept invite")
            end
        end)
        
        if success then
            return true
        end
    end
    
    -- Alternative: Look for CommF_ remote (same as joining Pirates)
    local commF = remotes:FindFirstChild("CommF_")
    if commF then
        print("🔄 Trying CommF_ remote...")
        local success = pcall(function()
            commF:InvokeServer("AcceptInvite")
        end)
        if success then
            print("✅ Accepted via CommF_")
            return true
        end
    end
    
    print("❌ Could not find accept remote")
    return false
end

-- Alternative: Get the invite data and accept through remote
local function acceptWithInviteData()
    -- Find the current invite
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    
    local crew = main:FindFirstChild("Crew")
    if not crew then return false end
    
    local create = crew:FindFirstChild("Create")
    if not create then return false end
    
    local invite = create:FindFirstChild("Invite")
    if not invite then return false end
    
    -- Try to get inviter name from the invite frame
    local inviterName = nil
    local inviterLabel = invite:FindFirstChild("InviterName")
    if inviterLabel then
        inviterName = inviterLabel.Text
        print("📨 Invite from: " .. inviterName)
    end
    
    -- Find the remote to accept
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local remotes = replicatedStorage:FindFirstChild("Remotes")
    
    if remotes and inviterName then
        local acceptRemote = remotes:FindFirstChild("AcceptCrewInvite")
        if acceptRemote then
            pcall(function()
                if acceptRemote:IsA("RemoteEvent") then
                    acceptRemote:FireServer(inviterName)
                else
                    acceptRemote:InvokeServer(inviterName)
                end
                print("✅ Accepted invite from: " .. inviterName)
                return true
            end)
        end
    end
    
    return false
end

